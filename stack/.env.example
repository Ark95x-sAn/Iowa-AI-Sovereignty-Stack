# Iowa AI Sovereignty Stack — configuration
# Copy this file to ".env" and adjust as needed:
#
#   cp .env.example .env
#
# All values below have sensible defaults; .env is optional.

# Port for the Open WebUI chat interface -> http://localhost:<WEBUI_PORT>
WEBUI_PORT=3000

# Port the Ollama API listens on
OLLAMA_PORT=11434

# Require a login for the web UI (recommended). The FIRST account you
# create becomes the admin. Set to False only for a trusted local machine.
WEBUI_AUTH=True

# Branding shown in the web UI
WEBUI_NAME=Iowa AI Sovereignty Stack

# Model pulled automatically on first start (see README for options).
# Good balance of quality/speed on a typical laptop: llama3.2:3b
# Low-RAM / quick test: qwen2.5:0.5b   Stronger (needs more RAM): llama3.1:8b
DEFAULT_MODEL=llama3.2:3b
