# Iowa AI Sovereignty Stack — OpenClaw configuration
# Copy to ".env" (start.sh does this for you and fills in a token):
#
#   cp .env.example .env

# Official project image (Docker Hub mirror). ghcr.io/openclaw/openclaw:latest
# is the primary registry if your network can reach it.
OPENCLAW_IMAGE=openclaw/openclaw:latest

# Host ports
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Shared secret for the gateway/control UI. Leave blank and start.sh generates
# one. Keep it private — anyone with this token can drive the gateway.
OPENCLAW_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# Optional, faster alternatives to the free local CPU model (see README):
#
# 1) Free hosted API (e.g. Groq free tier) — edit openclaw.json to add an
#    OpenAI-compatible provider and set your key here, e.g.:
# GROQ_API_KEY=
#
# 2) Claude via your existing Claude web session instead of a paid API key
#    (gray-area / fragile — see README). Uncomment and paste your session key:
# CLAUDE_AI_SESSION_KEY=
